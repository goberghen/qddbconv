[Desktop Entry]
Type=Application
Name=Qddbconv Audio Converter
GenericName=Audio Converter
Comment=Standalone Qt6 audio converter inspired by DeaDBeeF
Exec=qddbconv %F
Icon=qddbconv
Terminal=false
Categories=AudioVideo;Audio;AudioVideoEditing;Qt;KDE;
